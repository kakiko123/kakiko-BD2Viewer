# ============================================================
#  BD2 L2D Viewer — .gitignore
#  目标：clone 下来能直接跑；构建产物、本地环境、个人配置、密钥一律不进仓库。
# ============================================================

# ------------------------------------------------------------
# Android / Gradle 构建产物
# ------------------------------------------------------------
.gradle/
build/
*/build/
captures/
.externalNativeBuild/
.cxx/
release/
*.apk
*.aab
*.ap_
*.dex
*.class
output.json
lint-results*.html
lint-results*.xml

# 构建中间产物与调试输出
*.log
!docs/**/*.log

# ------------------------------------------------------------
# 本地环境与个人配置（每台机器都不一样，绝不能提交）
# ------------------------------------------------------------
# Android SDK / JDK 的绝对路径（由 Android Studio 或 sdkmanager 生成）
local.properties

# 本地代理、签名口令等机器相关配置
# 约定：这类内容写在这里，而不是写进 gradle.properties
gradle.local.properties

# 桌面版的服务配置：里面的 roots 是使用者自己的磁盘路径
bd2-local-viewer/viewer.config.json
bd2-local-viewer/viewer.config.local.json

# ------------------------------------------------------------
# 密钥与签名文件（绝不能提交到公开仓库）
# ------------------------------------------------------------
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
!**/debug.keystore.sample

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Node
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# 本仓库的开发辅助目录（不属于项目本身）
# ------------------------------------------------------------
# 本地工具链（JDK / Android SDK / Gradle，1.5GB 级别）
/toolchain/

# 临时工作区：调试脚本、构建日志、一次性补丁
/_scratch/

# 开发过程记录（若希望保留，删掉下面这行）
/.workbuddy/

# bd2-local-viewer 下的开发残留
# 下划线开头 = 一次性调试产物，里面常带开发机自己的磁盘路径，绝不能提交
bd2-local-viewer/_scratch/
bd2-local-viewer/_scan.json

# ------------------------------------------------------------
# 测试运行产生的截图、DOM 快照与日志（可随时重新生成）
# 保留 _test/*.mjs 源码与 fixture，产物不进仓库。
# ------------------------------------------------------------
bd2-local-viewer/_test/*.log
bd2-local-viewer/_test/dom*.html
bd2-local-viewer/_test/shot*.png
bd2-local-viewer/_test/pick_*.png
bd2-local-viewer/_test/zoom*.png
bd2-local-viewer/_test/e2e.png
bd2-local-viewer/_test/e2e_*.png

# ------------------------------------------------------------
# 界面截图一律不随仓库分发
# 截图必然用到付费取得的 L2D 资产，且部分内容不适合公开传播；
# 把含素材的截图提交进公开仓库 = 分发受版权保护的素材。见 README §2。
# ------------------------------------------------------------
docs/screenshots/

# ------------------------------------------------------------
# 打包产物（由 bundle.mjs 生成，构建时自动产生）
# 说明：这一份是 APK 的实际输入，需要随仓库提供，故不忽略。
# 如果你希望仓库里不留生成物，取消下面一行的注释。
# ------------------------------------------------------------
# bd2-local-viewer/public/app.bundle.html
# local helper - machine specific absolute paths, keep out of the repo
push_to_github.bat

# JCZX desktop extract cache (under any asset root)
.bd2viewer-jczx/

# JCZX local Python venv (created by setup_jczx.bat/sh or auto on first scan)
.venv-jczx/
**/.venv-jczx/

